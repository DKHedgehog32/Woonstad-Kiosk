            {!$Record.Primary_Billing_Address__r.House_Number_Addition__c}, 
IF(
   AND(
           ISBLANK({!$Record.Primary_Billing_Address__r.House_Number_Addition__c}),
           NOT(ISBLANK({!$Record.Primary_Billing_Address__r.House_Letter__c}))
